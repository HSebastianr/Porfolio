---
import ButtonProject from "@/components/ButtonProject.astro";
import JSIcon from "@/components/icons/Js.astro";
import TailwindIcon from "@/components/icons/Tailwind.astro";
import ReactIcon from "@/components/icons/React.astro";
import AstroIcon from "@/components/icons/Astros.astro";
import LinkIcon from "@/components/icons/Link.astro";
import CodeIcon from "@/components/icons/Code.astro";
import NextjsIcon from "@/components/icons/Nextjs.astro";
import FirebaseIcon from "@/components/icons/Firebase.astro";
import TypescriptIcon from "@/components/icons/Typescript.astro";
import NodejsIcon from "@/components/icons/Nodejs.astro";
import ViteIcon from "@/components/icons/Vite.astro";
import DockerIcon from "@/components/icons/Docker.astro";
import SupabaseIcon from "@/components/icons/Supabase.astro";
import PostgresqlIcon from "@/components/icons/Postgresql.astro";
import MongodbIcon from "@/components/icons/Mongodb.astro";
import GitIcon from "@/components/icons/Git.astro";
import { getI18N } from "@/i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const TAGS = {
  JS: {
    name: "Javascript",
    class:
      "bg-yellow-100 text-yellow-800 dark:bg-transparent dark:text-yellow-300 border-yellow-300",
    icon: JSIcon,
  },
  TAILWIND: {
    name: "Tailwind",
    class:
      "bg-sky-100 text-sky-800 dark:bg-transparent dark:text-sky-300 border-sky-300",
    icon: TailwindIcon,
  },
  REACT: {
    name: "React",
    class:
      "bg-blue-100 text-blue-800 dark:bg-transparent dark:text-blue-300 border-blue-300",
    icon: ReactIcon,
  },
  ASTRO: {
    name: "Astro",
    class:
      "bg-orange-100 text-orange-800 dark:bg-transparent dark:text-orange-300 border-orange-300",
    icon: AstroIcon,
  },
  NEXT: {
    name: "Nextjs",
    class:
      "bg-neutral-200 text-black dark:bg-transparent dark:text-white dark:border-white border-black",
    icon: NextjsIcon,
  },
  FIREBASE: {
    name: "Firebase",
    class:
      "bg-orange-100 text-orange-800 dark:bg-transparent dark:text-orange-300 border-orange-300",
    icon: FirebaseIcon,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class:
      "bg-indigo-100 text-indigo-800 dark:bg-transparent dark:text-indigo-300 border-indigo-300",
    icon: TypescriptIcon,
  },
  NODE: {
    name: "Node.js",
    class:
      "bg-lime-100 text-lime-800 dark:bg-transparent dark:text-lime-300 border-lime-300",
    icon: NodejsIcon,
  },
  VITE: {
    name: "Vite",
    class:
      "bg-purple-100 text-purple-800 dark:bg-transparent dark:text-purple-300 border-purple-300",
    icon: ViteIcon,
  },
  DOCKER: {
    name: "Docker",
    class:
      "bg-cyan-100 text-cyan-800 dark:bg-transparent dark:text-cyan-300 border-cyan-300",
    icon: DockerIcon,
  },
  SUPABASE: {
    name: "Supabase",
    class:
      "bg-emerald-100 text-emerald-800 dark:bg-transparent dark:text-emerald-300 border-emerald-300",
    icon: SupabaseIcon,
  },
  POSTGRES: {
    name: "PostgreSQL",
    class:
      "bg-blue-100 text-blue-800 dark:bg-transparent dark:text-blue-300 border-blue-300",
    icon: PostgresqlIcon,
  },
  MONGODB: {
    name: "MongoDB",
    class:
      "bg-green-100 text-green-800 dark:bg-transparent dark:text-green-300 border-green-300",
    icon: MongodbIcon,
  },
  GIT: {
    name: "Git",
    class:
      "bg-red-100 text-red-800 dark:bg-transparent dark:text-red-300 border-red-300",
    icon: GitIcon,
  },
};

const Projects = [
  {
    titulo: `${i18n.PROJECTOS_TITLE_2}`,
    texto: `${i18n.PROJECTOS_DESCRIPTION_2}`,
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TAILWIND, TAGS.FIREBASE,],
    code: "https://github.com/HSebastianr/DevFlow-IA",
    demo: "https://devflowia.netlify.app/",
    img: "/imageIA.png",
  },
  {
    titulo: `${i18n.PROJECTOS_TITLE_3}`,
    texto: `${i18n.PROJECTOS_DESCRIPTION_3}`,
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TAILWIND,],
    demo: "https://syrose.netlify.app/",
    img: "/imageSyro.png",
  },
  {
    titulo: `${i18n.PROJECTOS_TITLE_4}`,
    texto: `${i18n.PROJECTOS_DESCRIPTION_4}`,
    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.SUPABASE],
    demo: "https://kingmobiless.netlify.app/",
    img: "/imageKing.png",
  },
];
---

<section class="grid grid-rows-1 md:grid-cols-2 lg:grid-cols-2 justify-items-center gap-y-10 my-10">
  {
    Projects.map(({ titulo, texto, tags, code, demo, img }) => (
      <div class=" max-w-sm bg-white border border-gray-200 rounded-lg shadow dark:bg-transparent dark:border-[#212121]">
        <div class="relative">
          <img
            class="rounded-t-lg w-full h-48 md:h-56 object-cover"
            src={img}
            alt=""
          />
          <div
            class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-b from-transparent to-white dark:to-[#000000ea]
       pointer-events-none"
          ></div>
        </div>
        <div class="p-5">
          <div class="flex flex-wrap gap-2 mb-2">
            {tags.map((tag) => (
              <li
                class={`flex justify-center p-1 px-3 border rounded-full ${tag.class}`}
              >
                <span class="flex items-center gap-2 text-sm">
                  {tag.icon && <tag.icon class="size-4" />}
                  {tag.name}
                </span>
              </li>
            ))}
          </div>
          <a href="#">
            <h5 class="mb-2 text-xl md:text-2xl lg:text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
              {titulo}
            </h5>
          </a>
          <p class="mb-3 text-sm md:text-base lg:text-base font-normal text-gray-700 dark:text-white/80">
            {texto}
          </p>

          {code && (
            <ButtonProject href={code} target="_blank">Code <CodeIcon class="mx-1 size-5" /></ButtonProject>
          )}
          <ButtonProject href={demo} target="_blank">Ver demo <LinkIcon class="mx-1 size-5" /></ButtonProject>
        </div>
      </div>
    ))
  }
</section>
